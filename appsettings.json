{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Server": {
    "Port": 5000
  },
  "Jwt": {
    "Secret": "your-secret-key-must-be-at-least-32-characters-long-change-this-in-production",
    "Issuer": "AScheduler",
    "Audience": "ASchedulerAPI",
    "ExpirationMinutes": 120
  },
  "Scheduler": {
    "IntervalSeconds": 5,
    "DefaultProcessTimeoutMinutes": 30
  },
  "WorkerPool": {
    "WorkerCount": 4,
    "MaxRetries": 0,
    "RetryDelayMilliseconds": 1000,
    "TaskTimeoutSeconds": 60,
    "StaleExecutionThresholdMinutes": 15
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=ASchedulerDB;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}

