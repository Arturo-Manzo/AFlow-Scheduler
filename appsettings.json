{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "CHRONIQ"
    }
  },
  "Jwt": {
    "Secret": "CHANGE_ME_USE_USER_SECRETS_OR_ENVIRONMENT_VARIABLES_ONLY",
    "Issuer": "CHRONIQ",
    "Audience": "CHRONIQAPI",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Scheduler": {
    "IntervalSeconds": 5
  },
  "WorkerPool": {
    "WorkerCount": 4,
    "TaskTimeoutSeconds": 60,
    "StaleExecutionThresholdMinutes": 15,
    "StaleThresholdMultiplier": 3.0,
    "StaleThresholdMaxMinutes": 120,
    "StaleThresholdSampleSize": 10,
    "StaleThresholdCacheTtlMinutes": 5,
    "Retry": {
      "MaxAutomaticAttempts": 2,
      "BaseDelaySeconds": 5
    }
  },
  "Notifications": {
    "Smtp": {
      "Enabled": true,
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromDisplayName": "",
      "EnableSsl": true
    }
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=CHRONIQDB;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}

