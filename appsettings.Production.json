{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5000"
            }
        }
    },
    "WindowsService": {
        "ServiceName": "CHRONIQ"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Sinks.MSSqlServer"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "Enrich": [
            "FromLogContext"
        ],
        "Properties": {
            "Application": "CHRONIQ"
        }
    },
    "Jwt": {
        "Secret": "__FROM_ENV__",
        "Issuer": "CHRONIQ",
        "Audience": "CHRONIQAPI",
        "ExpirationMinutes": 120
    },
    "Cors": {
        "AllowedOrigins": [
            "http://frontend:4000"
        ]
    },
    "Scheduler": {
        "IntervalSeconds": 5
    },
    "WorkerPool": {
        "WorkerCount": 4,
        "AutoRecoverStaleExecutions": true,
        "TaskTimeoutSeconds": 60,
        "StaleExecutionThresholdMinutes": 15,
        "StaleThresholdMultiplier": 3.0,
        "StaleThresholdMaxMinutes": 120,
        "StaleThresholdSampleSize": 10,
        "StaleThresholdCacheTtlMinutes": 5,
        "Retry": {
            "MaxAutomaticAttempts": 2,
            "BaseDelaySeconds": 5
        }
    },
    "Notifications": {
        "Smtp": {
            "Enabled": true,
            "Host": "",
            "Port": 587,
            "Username": "",
            "Password": "",
            "FromAddress": "",
            "FromDisplayName": "",
            "EnableSsl": true
        }
    },
    "ConnectionStrings": {
        "Default": "Server=(localdb)\\MSSQLLocalDB2025;Database=CHRONIQDB;Trusted_Connection=True;TrustServerCertificate=True"
    }
}
