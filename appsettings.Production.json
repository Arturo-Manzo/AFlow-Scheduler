{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.Hosting.Lifetime":  "Information"
                                 }
                },
    "Serilog":  {
                    "Using":  [
                                  "Serilog.Sinks.Console",
                                  "Serilog.Sinks.File",
                                  "Serilog.Sinks.MSSqlServer"
                              ],
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Warning",
                                                          "Microsoft.AspNetCore":  "Warning",
                                                          "Microsoft.Hosting.Lifetime":  "Information"
                                                      }
                                     },
                    "Enrich":  [
                                   "FromLogContext"
                               ],
                    "Properties":  {
                                       "Application":  "AScheduler"
                                   }
                },
    "Jwt":  {
                "Secret":  "__FROM_ENV__",
                "Issuer":  "AScheduler",
                "Audience":  "ASchedulerAPI",
                "ExpirationMinutes":  120
            },
    "Cors":  {
                 "AllowedOrigins":  [

                                    ]
             },
    "Scheduler":  {
                      "IntervalSeconds":  5
                  },
    "WorkerPool":  {
                       "WorkerCount":  4,
                       "TaskTimeoutSeconds":  60,
                       "StaleExecutionThresholdMinutes":  15,
                       "StaleThresholdMultiplier":  3.0,
                       "StaleThresholdMaxMinutes":  120,
                       "StaleThresholdSampleSize":  10,
                       "StaleThresholdCacheTtlMinutes":  5,
                       "Retry":  {
                                     "MaxAutomaticAttempts":  2,
                                     "BaseDelaySeconds":  5
                                 }
                   },
    "Notifications":  {
                          "Smtp":  {
                                       "Enabled":  true,
                                       "Host":  "",
                                       "Port":  587,
                                       "Username":  "",
                                       "Password":  "",
                                       "FromAddress":  "",
                                       "FromDisplayName":  "",
                                       "EnableSsl":  true
                                   }
                      },
    "ConnectionStrings":  {
                              "Default":  "Server=(localdb)\\MSSQLLocalDB;Database=ASchedulerDB;Trusted_Connection=True;TrustServerCertificate=True"
                          }
}
